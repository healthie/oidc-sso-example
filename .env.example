# Copy to .env.local and fill in. Use a STAGING application only.

# The provider's base URL (discovery is at {authority}/.well-known/openid-configuration)
VITE_OIDC_AUTHORITY=https://<your-auth-url>

# The application's client_id
VITE_OIDC_CLIENT_ID=

# Must be registered as a redirect URI on the application
VITE_OIDC_REDIRECT_URI=

# Optional: GraphQL endpoint to call with the access token (shows a "Call API" button)
VITE_API_URL=

# Optional: query to send, defaults to { __typename }
VITE_API_QUERY=

# Optional: space-separated scopes
VITE_OIDC_SCOPE=openid profile email

# Optional: sent as the `organization` param on the authorize request
VITE_OIDC_ORGANIZATION=
